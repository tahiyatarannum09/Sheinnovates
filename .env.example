# AgriLoop Demo Authentication Configuration (Hackathon / Demo Only)
# Copy this file to `.env.local` and fill in the demo account credentials.
# NEVER commit `.env` or `.env.local` with real or demo passwords to GitHub.
#
# Limitation: Because AgriLoop is a frontend-only Vite React app, VITE_* variables
# are bundled into client-side assets at build time. Use only for local/hackathon demos.

VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_ADMIN_NAME=Admin Demo User

VITE_DEMO_CUSTOMER_EMAIL=
VITE_DEMO_CUSTOMER_PASSWORD=
VITE_DEMO_CUSTOMER_NAME=Customer Demo User
